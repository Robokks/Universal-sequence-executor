  <Control _name="threshold_ms" conIdx="5" connection="required" outputs="value:102.value" type="double" uid="102" uid_parent="root" value="0" />
  <Node _name="Greater Or Equal?" inputs="x:101.value,y:102.value" outputs="x &gt;= y?:103.x &gt;= y?" uid="103" uid_parent="root" />
