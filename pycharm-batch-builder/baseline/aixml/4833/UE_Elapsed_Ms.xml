<VI _name="UE_Elapsed_Ms.vi" description="Compute elapsed monotonic milliseconds\2C caller guarantees now not earlier than start">
  <Control _name="now_ms" conIdx="0" connection="required" outputs="value:101.value" type="double" uid="101" uid_parent="root" value="0" />
  <Control _name="start_ms" conIdx="5" connection="required" outputs="value:102.value" type="double" uid="102" uid_parent="root" value="0" />
  <Node _name="Subtract" inputs="x:101.value,y:102.value" outputs="x-y:103.x-y" uid="103" uid_parent="root" />
  <Indicator _name="elapsed_ms" conIdx="4" connection="recommended" inputs="value:103.x-y" type="double" uid="104" uid_parent="root" value="0" />
</VI>
